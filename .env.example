# ==============================================================================
# ForestWatch Environment Configuration Template
# Copy this file to '.env' and fill in secure values before deploying.
#
# DO NOT commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Required: Shared service-to-service key for sensor and central authentication
# Must match across central-server and all sensor node instances.
FORESTWATCH_SECURITY_SERVICE_KEY=change-this-to-a-strong-random-key-in-production

# Required for Monitoring profile: Grafana Administrator Password
GRAFANA_ADMIN_PASSWORD=change-this-to-a-secure-password

# Optional: SQLite Database Path (Defaults to /data/forestwatch.db in Docker)
SQLITE_DB_PATH=/data/forestwatch.db

# Optional: AWS Region and Cloud Integration
AWS_REGION=ap-south-1
AWS_S3_BUCKET=forestwatch-telemetry-archive
AWS_LAMBDA_FUNCTION_NAME=EmergencyAlertDispatcher
