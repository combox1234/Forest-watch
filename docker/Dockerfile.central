FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /workspace

# Install Maven in the build stage (tools/ is gitignored and unavailable after clone)
RUN apk add --no-cache maven

COPY pom.xml ./
COPY shared/ ./shared/
COPY central-server/ ./central-server/
COPY sensor-server/ ./sensor-server/

RUN mvn install -N && \
    mvn install -pl shared && \
    mvn package -pl central-server -DskipTests

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /workspace/central-server/target/central-server-1.0.0.jar app.jar

EXPOSE 8000
ENTRYPOINT ["java", "-jar", "app.jar"]
