FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /workspace

RUN apk add --no-cache maven

COPY pom.xml ./
COPY shared/ ./shared/
COPY central-server/ ./central-server/
COPY sensor-server/ ./sensor-server/

RUN mvn install -N && \
    mvn install -pl shared && \
    mvn package -pl central-server -DskipTests

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Run as non-root user for security best practices (UID 1000 matches Kubernetes fsGroup 1000)
# Install sqlite package to provide reliable sqlite3 CLI for online database backups and diagnostic inspection
RUN apk add --no-cache sqlite && \
    addgroup -g 1000 -S forestwatch && adduser -u 1000 -S forestwatch -G forestwatch && \
    mkdir -p /data && chown -R forestwatch:forestwatch /data && chmod 775 /data

VOLUME ["/data"]

USER forestwatch:forestwatch

COPY --from=build --chown=forestwatch:forestwatch /workspace/central-server/target/central-server-1.0.0.jar app.jar

ENV SERVER_PORT=8099
ENV SQLITE_DB_PATH=/data/forestwatch.db
EXPOSE 8099

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${SERVER_PORT}/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
