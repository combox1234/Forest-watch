FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /workspace

RUN apk add --no-cache maven

COPY pom.xml ./
COPY shared/ ./shared/
COPY central-server/ ./central-server/
COPY sensor-server/ ./sensor-server/

RUN mvn install -N && \
    mvn install -pl shared && \
    mvn package -pl sensor-server -DskipTests

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Run as non-root user for security best practices
RUN addgroup -S forestwatch && adduser -S forestwatch -G forestwatch
USER forestwatch:forestwatch

COPY --from=build --chown=forestwatch:forestwatch /workspace/sensor-server/target/sensor-server-1.0.0.jar app.jar

ENV SERVER_PORT=8101
EXPOSE 8101 8102 8103 8104

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${SERVER_PORT}/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
